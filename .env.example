# Discord: Server Settings > Integrations > Webhooks > New Webhook > Copy URL
DISCORD_WEBHOOK_URL=

# Telegram: create a bot with @BotFather, then message it once and get your chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# How often the background tracker checks (hours)
CHECK_INTERVAL_HOURS=3

# Web dashboard
ENABLE_TRACKER=1
DEMO_MODE=0
DB_PATH=prices.db
